# Copy to .env and fill in. Never commit .env or anything in secrets/.
# Check everything with:  uv run infra/check_access.py
# A check whose variables are empty is reported as SKIP.

# --- NVIDIA Build (Nemotron 3.5 Super VL) ---------------------------------
# Comma-separated, one key per teammate. The access check tests each key.
NVIDIA_API_KEYS=
# Leave empty to auto-detect the Super VL ID from the NVIDIA Build catalog.
NEMOTRON_MODEL=

# --- Aiven for Apache Kafka -------------------------------------------------
# host:port from the service's Quick connect panel. SASL and client-certificate
# auth use different ports, so copy the one for the method you pick.
KAFKA_BOOTSTRAP=
# CA certificate from the Aiven console (needed for both auth methods).
KAFKA_CA_FILE=secrets/kafka-ca.pem
# SASL/SCRAM-SHA-256: Aiven's recommended method, on by default for new services.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# ...or client-certificate auth (leave the SASL fields empty):
KAFKA_CERT_FILE=
KAFKA_KEY_FILE=
# The check writes one test message here. Create this topic in the Aiven console.
KAFKA_CHECK_TOPIC=access-check

# --- Aiven for PostgreSQL ---------------------------------------------------
# Service URI from the Aiven console (it includes ?sslmode=require).
DATABASE_URL=

# --- Hostinger --------------------------------------------------------------
# hPanel -> API. The check only reads (lists your VPS).
HOSTINGER_API_TOKEN=
VPS_HOST=
VPS_SSH_USER=root
# Optional private key path; otherwise your SSH agent / ~/.ssh/config is used.
VPS_SSH_KEY=
# The free domain once it points at the VPS, e.g. https://example.com
PUBLIC_URL=

# --- Optional overrides -----------------------------------------------------
JETSTREAM_URL=
JETSTREAM_SAMPLE_SECONDS=10

# --- No job assigned yet (CLAUDE.md §9) -------------------------------------
# HOSTINGER_AI_ROUTER_KEY=
# VERDA_API_KEY=
